<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.CF.Shop.CFCounterWindow"
               Title="{Loc 'cf-counter-title'}"
               SetSize="760 460"
               MinSize="560 300">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Text="{Loc 'cf-counter-hint'}" />
        <BoxContainer Name="Header" Orientation="Vertical" HorizontalExpand="True" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Rows" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" />
        </ScrollContainer>
        <Label Name="EmptyLabel" Text="{Loc 'cf-counter-empty'}" HorizontalAlignment="Center" Visible="False" />
        <Label Name="WalletLabel" FontColorOverride="#E6C15A" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="12">
            <Button Name="StoredButton" MinSize="160 32" />
            <Button Name="ShopButton" Text="{Loc 'cf-merchant-buy'}" MinSize="160 32" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
