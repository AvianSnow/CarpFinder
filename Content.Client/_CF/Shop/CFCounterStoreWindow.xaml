<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.CF.Shop.CFCounterStoreWindow"
               Title="{Loc 'cf-counter-stored-title'}"
               SetSize="820 520"
               MinSize="600 320">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Text="{Loc 'cf-counter-stored-hint'}" />
        <LineEdit Name="SearchInput" PlaceHolder="{Loc 'cf-shop-search'}" HorizontalExpand="True" />
        <BoxContainer Name="Header" Orientation="Vertical" HorizontalExpand="True" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Rows" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" />
        </ScrollContainer>
        <Label Name="EmptyLabel" Text="{Loc 'cf-counter-stored-empty'}" HorizontalAlignment="Center" Visible="False" />
        <Label Name="TotalLabel" FontColorOverride="#E6C15A" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="12">
            <Button Name="SellAllButton" Text="{Loc 'cf-counter-sell-all'}" MinSize="200 32" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
