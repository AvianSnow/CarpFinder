# Buttons on the alerts panel, beside the temperature and pressure icons.

cf-alert-sleep-name = [color=yellow]Sleep[/color]
cf-alert-sleep-desc = You are in a bed. Click to go to sleep: a long rest restores your Hit Points, spell slots and focus points.
cf-alert-wake-name = [color=yellow]Asleep[/color]
cf-alert-wake-desc = You are asleep. Click to wake up.

cf-alert-look-up-name = [color=yellow]Look up[/color]
cf-alert-look-up-desc = There is a level above you. Click to look up at it, where its floor lets you see through.
cf-alert-look-down-name = [color=yellow]Looking up[/color]
cf-alert-look-down-desc = You are looking at the level above. Click to look back down at your own.
