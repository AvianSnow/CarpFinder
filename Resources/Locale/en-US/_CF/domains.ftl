# Domains (cfDomain) and the domain spells cast as reactions.
cf-domain-sun = Sun
cf-domain-sun-desc = Dazzling Flash: a 15-foot cone of light dazzles or blinds.
cf-domain-healing = Healing
cf-domain-healing-desc = Healer's Blessing: an ally gains more from healing spells for a minute.
cf-domain-repose = Repose
cf-domain-repose-desc = Share Burden (reaction, 1 Focus Point): when an ally within 30 feet fails a save against an emotion effect, its result is one degree better.
cf-domain-truth = Truth
cf-domain-truth-desc = Word of Truth: +2 to Diplomacy while you speak the truth.
cf-domain-duty = Duty
cf-domain-duty-desc = Swear Oath: +1 to attack rolls and skill checks for 6 seconds.
cf-domain-protection = Protection
cf-domain-protection-desc = Protector's Sacrifice (reaction, 1 Focus Point): when an ally within 30 feet takes damage, you take 3 of it per spell rank instead.
cf-domain-creation = Creation
cf-domain-creation-desc = Creative Splash: a splash of colour that dazzles, enfeebles, frightens or makes clumsy.
cf-domain-earth = Earth
cf-domain-earth-desc = Hurtling Stone: a thrown stone, 2d6 bludgeoning and a push.
cf-domain-family = Family
cf-domain-family-desc = Soothing Words: an ally gains +1 to Will saves, +2 against emotion.
cf-domain-air = Air
cf-domain-air-desc = Pushing Gust: a gust pushes a creature up to 10 feet, and can knock it prone.
cf-domain-travel = Travel
cf-domain-travel-desc = Agile Feet: faster, a free Step, and difficult terrain ignored for 6 seconds.
cf-domain-luck = Luck
cf-domain-luck-desc = Bit of Luck: a creature rolls its next save twice.
cf-domain-death = Death
cf-domain-death-desc = Death's Call (reaction, 1 Focus Point): when a creature within 20 feet dies, you gain temporary Hit Points equal to its level plus your spellcasting modifier, doubled for undead.
cf-domain-fate = Fate
cf-domain-fate-desc = Read Fate: one word about a creature's near future.
cf-domain-soul = Soul
cf-domain-soul-desc = Eject Soul: a touch that stuns.
cf-domain-secrecy = Secrecy
cf-domain-secrecy-desc = Whispering Quiet: sound muffled in a 15-foot burst. TBA
cf-domain-trickery = Trickery
cf-domain-trickery-desc = Sudden Shift (reaction, 1 Focus Point): when an enemy misses you in melee, you Step for free and are concealed for 6 seconds.
cf-domain-darkness = Darkness
cf-domain-darkness-desc = Cloak of Shadow: a willing creature is concealed for a minute.
cf-domain-undeath = Undeath
cf-domain-undeath-desc = Touch of Undeath: void damage, and healing on the target is halved.
cf-domain-tyranny = Tyranny
cf-domain-tyranny-desc = Touch of Obedience: a touch that stupefies, and can knock prone.
cf-domain-might = Might
cf-domain-might-desc = Athletic Rush: +10 feet Speed and +2 to Athletics for 6 seconds.
cf-reaction-share-burden = Share Burden
cf-reaction-protectors-sacrifice = Protector's Sacrifice
cf-reaction-deaths-call = Death's Call
cf-reaction-sudden-shift = Sudden Shift
cf-read-fate = Fate: {$word}
cf-read-fate-inconclusive = inconclusive
cf-read-fate-word-1 = ash
cf-read-fate-word-2 = crown
