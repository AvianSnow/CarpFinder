# What a tribe member remembers. These are also what it tells its tribemates, and what a language model is shown.
cf-tribe-memory-stranger = Saw { $who } near the nest.
cf-tribe-memory-game = Saw { $who } near the nest. Good eating.
cf-tribe-memory-attacked = { $who } attacked { $name }!
cf-tribe-memory-tribute = { $who } gave the tribe food.
cf-tribe-memory-leader = { $name } leads the tribe now.
cf-tribe-memory-heard = { $name } said: { $line }
cf-tribe-memory-stranger-said = { $who } said to us: '{ $line }'
cf-tribe-memory-strange-tongue = { $who } spoke to us in a tongue we do not know.
cf-tribe-memory-stock-low = The stores are nearly empty.
cf-tribe-memory-soil-dry = The soil is dry.
cf-tribe-memory-soil-poor = The soil is poor and needs ash.
cf-tribe-memory-soil-ready = A crop is ready to pick.

# What a tribe member says when no language model gave it a line.
cf-tribe-line-demand = Halt, big-folk! Give food and you pass safe!
cf-tribe-line-attack = No food? Then the tribe takes it! Get them!
cf-tribe-line-thanks = Good. Tribe eats. You go safe.
cf-tribe-line-share = Here, { $name }. Eat.
cf-tribe-line-chat-1 = Quiet day. Good day.
cf-tribe-line-chat-2 = Fire is warm. Stay close.
cf-tribe-line-chat-3 = Smell anything? No? Good.
cf-tribe-line-chat-4 = The dragon watches over us.
cf-tribe-line-chat-5 = Keep your spear sharp.
