<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.CF.Lobby.UI.CharacterBuilder.PetInfoPopup"
               MinSize="480 360"
               SetSize="560 440">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" Margin="8">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <RichTextLabel Name="Body" />
        </ScrollContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="DismissButton" Text="{Loc 'cf-pet-close'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
