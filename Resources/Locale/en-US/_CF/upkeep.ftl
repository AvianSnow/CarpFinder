cf-cleanup-sender = The Dungeon Wizard
cf-cleanup-warning-minutes = The dungeon wizard will clean the dungeon in { $minutes ->
    [one] 1 minute
   *[other] { $minutes } minutes
}. Save your items in containers.
cf-cleanup-warning-seconds = The dungeon wizard will clean the dungeon in { $seconds } seconds. Save your items in containers.
cf-cleanup-done = The dungeon wizard has cleaned the dungeon. { $count ->
    [one] 1 thing was
   *[other] { $count } things were
} swept away.
