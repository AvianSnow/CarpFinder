<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.CF.Lobby.UI.CharacterBuilder.PetEditPopup"
               MinSize="640 480"
               SetSize="720 560">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" Margin="8">
        <Label Text="{Loc 'cf-pet-species'}" />
        <OptionButton Name="SpeciesButton" HorizontalExpand="True" />
        <Label Text="{Loc 'cf-pet-nickname'}" />
        <LineEdit Name="NicknameEdit" HorizontalExpand="True" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <RichTextLabel Name="DetailBody" Margin="0 4 0 0" />
        </ScrollContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="6">
            <Button Name="FinishedButton" Text="{Loc 'cf-pet-finished'}" />
            <Button Name="DismissButton" Text="{Loc 'cf-pet-close'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
